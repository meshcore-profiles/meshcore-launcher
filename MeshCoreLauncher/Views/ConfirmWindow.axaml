<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeshCoreLauncher.Views.ConfirmWindow"
        Title="MeshCore Launcher"
        Icon="avares://MeshCoreLauncher/Assets/icon.ico"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None">

	<Border CornerRadius="16" Background="{StaticResource Brush.Bg}"
	        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
		<StackPanel Margin="24,22,24,20" Spacing="18">
			<TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13.5"
			           Foreground="{StaticResource Brush.TextPrimary}" />
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
				<Button Content="Cancel" Click="Cancel_Click"
				        Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}"
				        Foreground="{StaticResource Brush.TextSecondary}" CornerRadius="10"
				        Padding="16,10" Cursor="Hand" />
				<Button x:Name="ConfirmButton" Classes="primary" Content="Continue" Click="Confirm_Click"
				        Width="140" Height="38" FontSize="13" FontWeight="SemiBold" CornerRadius="10" />
			</StackPanel>
		</StackPanel>
	</Border>

</Window>
