<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>

    <AssemblyName>MeshCoreLauncher</AssemblyName>
    <RootNamespace>MeshCoreLauncher</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

    <Company>Sefinek</Company>
    <Product>MeshCore Launcher</Product>
    <Title>MeshCore Launcher</Title>
    <FileDescription>Launcher and auto-updater for the MeshCore desktop app.</FileDescription>
    <Copyright>© 2026 Sefinek. Licensed under MIT.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Sefinek</Authors>
    <NeutralLanguage>en-US</NeutralLanguage>

    <Version>0.1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>

    <PackageProjectUrl>https://meshcoreprofiles.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/meshcore-profiles/meshcore-launcher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>MeshCore;Launcher;Updater</PackageTags>

    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\sign\meshcore-launcher.snk</AssemblyOriginatorKeyFile>

    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NLog" Version="6.2.0" />
  </ItemGroup>

</Project>
